{
  "lexicon": 1,
  "id": "fm.teal.stats.getLatest",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get latest plays globally",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "Number of latest plays to return"
          },
          "cursor": {
            "type": "string",
            "description": "Opaque cursor for the next page of plays"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["plays"],
          "properties": {
            "plays": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "fm.teal.feed.defs#playView"
              }
            },
            "cursor": {
              "type": "string",
              "description": "Opaque cursor for the next page of plays"
            }
          }
        }
      }
    }
  }
}
