{
  "lexicon": 1,
  "id": "fm.teal.feed.getToday",
  "description": "This lexicon is in a not officially released state. It is subject to change. | What the viewer's circle and the wider network are listening to right now and today.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "viewer": {
            "type": "string",
            "format": "did",
            "description": "The viewer. Without one, only network-wide moments are returned."
          },
          "tz": {
            "type": "string",
            "maxLength": 64,
            "description": "IANA time zone used to decide where 'today' starts. Defaults to UTC."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 12
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "listening",
            "moments",
            "heatingUp"
          ],
          "properties": {
            "listening": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#listeningView"
              }
            },
            "moments": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#momentView"
              }
            },
            "heatingUp": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#momentView"
              }
            }
          }
        }
      }
    },
    "listeningView": {
      "type": "object",
      "required": [
        "actor",
        "playUri",
        "trackName",
        "playedTime",
        "listeningNow",
        "trackPlaysToday",
        "releasePlaysToday"
      ],
      "properties": {
        "actor": {
          "type": "ref",
          "ref": "fm.teal.actor.defs#miniProfileView"
        },
        "playUri": {
          "type": "string",
          "format": "at-uri"
        },
        "playCid": {
          "type": "string",
          "format": "cid"
        },
        "trackName": {
          "type": "string"
        },
        "artistName": {
          "type": "string"
        },
        "recordingMbId": {
          "type": "string"
        },
        "releaseMbId": {
          "type": "string"
        },
        "releaseName": {
          "type": "string"
        },
        "playedTime": {
          "type": "string",
          "format": "datetime"
        },
        "listeningNow": {
          "type": "boolean",
          "description": "True while the actor's status is unexpired or their latest play started in the last ten minutes."
        },
        "trackPlaysToday": {
          "type": "integer",
          "minimum": 0
        },
        "releasePlaysToday": {
          "type": "integer",
          "minimum": 0
        },
        "firstReleaseListen": {
          "type": "boolean",
          "description": "True when today is the first day the actor has played this release."
        },
        "reactions": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "fm.teal.feed.social.defs#reactionSummary"
          }
        }
      }
    },
    "momentView": {
      "type": "object",
      "required": [
        "kind",
        "release",
        "listenerCount",
        "listeners"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "knownValues": [
            "mutuals",
            "network",
            "trending",
            "circle"
          ]
        },
        "release": {
          "type": "ref",
          "ref": "fm.teal.stats.defs#releaseSummary"
        },
        "listenerCount": {
          "type": "integer",
          "minimum": 0
        },
        "listeners": {
          "type": "array",
          "maxLength": 5,
          "items": {
            "type": "ref",
            "ref": "fm.teal.actor.defs#miniProfileView"
          },
          "description": "A sample of listeners the viewer follows."
        },
        "changePercent": {
          "type": "integer",
          "description": "For trending moments: today's listeners compared with the daily average of the previous seven days."
        }
      }
    }
  }
}
