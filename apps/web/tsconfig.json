{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "types": ["vite/client", "node"],
    "paths": { "~/*": ["./src/*"] }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
